APP_NAME="AI Studio Cloud"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- AI Studio Cloud ---
FRONTEND_URL=http://localhost:5173
# STUDIO_PACKAGES_PATH defaults to ../../packages (monorepo)
STUDIO_DEFAULT_PLAN=free
STUDIO_CHECKPOINT_INTERVAL=300
STUDIO_ASSET_DISK=assets
STUDIO_ASSET_DRIVER=local
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# TRUSTED_PROXIES=10.0.0.0/8

# --- AI (Phase 3) ---
# Platform key for Claude (optional; without it the offline template planner is used).
# Set it through your secret manager / environment, never commit it.
ANTHROPIC_API_KEY=
STUDIO_AI_MODEL=claude-opus-5-5
STUDIO_AI_EFFORT=medium
STUDIO_AI_MAX_TOKENS=16000
STUDIO_AI_TIMEOUT=240
STUDIO_AI_FALLBACKS=default
STUDIO_REGISTER_PER_HOUR=10
# Run an AI worker: php artisan queue:work --queue=ai,email,default

# ---- Publishing & domains (Phase 4) ----
# Published sites are served at <slug>.PLATFORM_BASE_DOMAIN (sites.localhost resolves to loopback in Chromium).
PLATFORM_BASE_DOMAIN=sites.localhost
# Custom domains must CNAME/ALIAS to this edge hostname.
PLATFORM_CNAME_TARGET=edge.sites.localhost
# Hosts that are the platform itself (never resolved as sites).
PLATFORM_HOSTS=localhost,127.0.0.1
PLATFORM_SLUG_COOLDOWN_DAYS=30
# system = real DNS lookups; static = JSON file (local/E2E only)
STUDIO_DNS_DRIVER=system
# STUDIO_DNS_STATIC_FILE=/path/to/dns.json
# probe = TLS handshake check; assume = treat certificates as valid (local/E2E only)
STUDIO_TLS_CHECK=probe
STUDIO_PUBLISH_REQUIRE_VERIFIED_EMAIL=true

# ---- Google OAuth (Sheets/Drive integration, Phase 5) ----
# Optional. Either set these, or let a platform admin enter them in Admin → Settings (stored encrypted).
# When set here they take precedence and the admin form becomes read-only.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Local/E2E only: send all Google API calls to a fake server (refused when APP_ENV=production).
# GOOGLE_FAKE_BASE=http://127.0.0.1:8002

# Webhooks to private/loopback addresses (local development only; never in production).
STUDIO_EGRESS_ALLOW_PRIVATE=false
