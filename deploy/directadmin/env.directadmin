# ===== AI Studio Cloud — .env for DirectAdmin shared hosting =====
# Copy to ai-studio/.env and replace every value marked CHANGE.
# Never send this file (or passwords/keys in it) by chat or e-mail.

APP_NAME="AI Studio Cloud"
APP_ENV=production
APP_DEBUG=false
# Leave empty: `php artisan studio:install` generates it once. Back up .env afterwards.
APP_KEY=
APP_URL=https://studio.example.com            # CHANGE: your domain (https)
FRONTEND_URL=https://studio.example.com       # CHANGE: same as APP_URL
APP_LOCALE=th
APP_TIMEZONE=Asia/Bangkok

LOG_CHANNEL=daily
LOG_LEVEL=warning

# MySQL — DirectAdmin → MySQL Management → Create new database
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE_dbname
DB_USERNAME=CHANGE_dbuser
DB_PASSWORD=CHANGE_dbpassword

# No Redis on shared hosting: database-backed sessions, cache and queue.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
SANCTUM_STATEFUL_DOMAINS=studio.example.com   # CHANGE: your domain (no https://)

# E-mail — DirectAdmin → E-mail Accounts (create e.g. no-reply@your-domain)
MAIL_MAILER=smtp
MAIL_HOST=mail.example.com                    # CHANGE
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=no-reply@example.com            # CHANGE
MAIL_PASSWORD=CHANGE_mailpassword
MAIL_FROM_ADDRESS=no-reply@example.com        # CHANGE
MAIL_FROM_NAME="${APP_NAME}"

# Studio / platform host (published sites need wildcard DNS + wildcard subdomain/SSL — see DEPLOY-TH.md)
PLATFORM_HOSTS=studio.example.com,www.studio.example.com   # CHANGE
PLATFORM_BASE_DOMAIN=sites.example.com        # CHANGE (only works with wildcard *.sites.example.com)
PLATFORM_CNAME_TARGET=sites.example.com       # CHANGE
STUDIO_PUBLISH_REQUIRE_VERIFIED_EMAIL=true

# Optional features (leave empty to disable)
ANTHROPIC_API_KEY=                            # AI: empty = offline template planner
GOOGLE_CLIENT_ID=                             # or set in Admin → Settings
GOOGLE_CLIENT_SECRET=
METRICS_TOKEN=

# Billing stays disabled in production until a real provider is approved.
BILLING_PROVIDER=test
