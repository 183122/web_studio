{
  "registryVersion": 1,
  "styleProperties": {
    "display": { "kind": "enum", "values": ["block", "flex", "grid", "inline-block", "none"] },
    "flexDirection": { "kind": "enum", "values": ["row", "column", "row-reverse", "column-reverse"] },
    "flexWrap": { "kind": "enum", "values": ["nowrap", "wrap"] },
    "alignItems": { "kind": "enum", "values": ["stretch", "flex-start", "center", "flex-end", "baseline"] },
    "justifyContent": { "kind": "enum", "values": ["flex-start", "center", "flex-end", "space-between", "space-around", "space-evenly"] },
    "columns": { "kind": "integer", "min": 1, "max": 12 },
    "gap": { "kind": "length" },
    "padding": { "kind": "box" },
    "margin": { "kind": "box" },
    "width": { "kind": "length" },
    "maxWidth": { "kind": "length" },
    "minHeight": { "kind": "length" },
    "height": { "kind": "length" },
    "color": { "kind": "color" },
    "backgroundColor": { "kind": "color" },
    "borderColor": { "kind": "color" },
    "borderWidth": { "kind": "length" },
    "borderRadius": { "kind": "length" },
    "boxShadow": { "kind": "enum", "values": ["none", "sm", "md", "lg"] },
    "fontFamily": { "kind": "enum", "values": ["$heading", "$body", "system", "serif", "mono"] },
    "fontSize": { "kind": "length" },
    "fontWeight": { "kind": "enum", "values": ["300", "400", "500", "600", "700", "800"] },
    "lineHeight": { "kind": "number", "min": 0.8, "max": 3 },
    "letterSpacing": { "kind": "length" },
    "textAlign": { "kind": "enum", "values": ["left", "center", "right", "justify"] },
    "textTransform": { "kind": "enum", "values": ["none", "uppercase", "lowercase", "capitalize"] },
    "objectFit": { "kind": "enum", "values": ["cover", "contain", "fill"] },
    "opacity": { "kind": "number", "min": 0, "max": 1 }
  },
  "components": {
