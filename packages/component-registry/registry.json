      "insertable": true,
      "props": {
        "tag": { "kind": "select", "label": "แท็ก HTML", "options": ["section", "header", "footer", "main", "div"], "default": "section" },
        "anchorId": { "kind": "slug", "label": "Anchor ID", "maxLength": 64, "default": "" },
        "backgroundImage": { "kind": "image", "label": "ภาพพื้นหลัง", "default": "" }
      },
      "defaultStyles": { "base": { "padding": "64px 24px" }, "mobile": { "padding": "40px 16px" } }
    },
    "Container": {
      "label": "Container",
      "labelTh": "กล่องจัดวาง",
      "category": "layout",
      "icon": "square",
      "acceptsChildren": true,
      "insertable": true,
      "props": {},
      "defaultStyles": { "base": { "display": "flex", "flexDirection": "column", "gap": "16px", "maxWidth": "1120px", "margin": "0 auto", "width": "100%" } }
    },
    "Columns": {
      "label": "Columns",
      "labelTh": "คอลัมน์ (Grid)",
      "category": "layout",
      "icon": "columns",
