      "defaultStyles": { "base": { "width": "100%", "objectFit": "cover", "borderRadius": "$radius" } }
    },
    "Video": {
      "label": "Video",
      "labelTh": "วิดีโอ",
      "category": "media",
      "icon": "video",
      "acceptsChildren": false,
      "insertable": true,
      "props": {
        "provider": { "kind": "select", "label": "ผู้ให้บริการ", "options": ["youtube", "vimeo"], "default": "youtube" },
        "videoId": { "kind": "videoId", "label": "Video ID", "default": "" },
        "title": { "kind": "text", "label": "ชื่อวิดีโอ (สำหรับผู้ใช้โปรแกรมอ่านหน้าจอ)", "maxLength": 200, "default": "วิดีโอ" }
      },
      "defaultStyles": { "base": { "width": "100%", "borderRadius": "$radius" } }
    },
    "Navbar": {
      "label": "Navbar",
      "labelTh": "แถบเมนู",
      "category": "navigation",
      "icon": "menu",
      "acceptsChildren": false,
      "insertable": true,
      "props": {
        "brand": { "kind": "text", "label": "ชื่อแบรนด์", "maxLength": 80, "default": "แบรนด์ของฉัน" },
        "logo": { "kind": "image", "label": "โลโก้", "default": "" },
        "links": { "kind": "links", "label": "เมนู", "maxItems": 12, "default": [{ "label": "หน้าแรก", "href": "/" }] }
      },
      "defaultStyles": { "base": { "padding": "16px 24px", "backgroundColor": "$surface" } }
    },
    "List": {
      "label": "List",
      "labelTh": "รายการ",
      "category": "basic",
      "icon": "list",
      "acceptsChildren": false,
      "insertable": true,
      "props": {
        "items": { "kind": "stringList", "label": "รายการ", "maxItems": 50, "maxLength": 500, "default": ["รายการที่ 1", "รายการที่ 2"] },
        "ordered": { "kind": "boolean", "label": "แบบมีลำดับเลข", "default": false }
      },
      "defaultStyles": { "base": { "lineHeight": 1.8 } }
    },
    "Divider": {
      "label": "Divider",
      "labelTh": "เส้นคั่น",
      "category": "basic",
      "icon": "minus",
      "acceptsChildren": false,
      "insertable": true,
      "props": {},
      "defaultStyles": { "base": { "borderColor": "$muted", "borderWidth": "1px", "margin": "16px 0" } }
    },
    "Spacer": {
      "label": "Spacer",
      "labelTh": "ช่องว่าง",
      "category": "basic",
      "icon": "move-vertical",
      "acceptsChildren": false,
      "insertable": true,
      "props": {},
      "defaultStyles": { "base": { "height": "32px" } }
    }
  }
}
