{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-studio.local/app-command/v1.json",
  "title": "AppCommand v1",
  "description": "A single typed mutation of an AppDefinition. Both the studio editor and the AI patcher MUST express changes as these commands.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "parentId", "index", "nodes"],
      "properties": {
        "type": { "const": "component.insert" },
        "parentId": { "$ref": "#/$defs/id" },
        "index": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "nodes": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "https://schemas.ai-studio.local/app-definition/v1.json#/$defs/component" } }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "const": "component.remove" },
        "id": { "$ref": "#/$defs/id" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "parentId", "index"],
      "properties": {
        "type": { "const": "component.move" },
        "id": { "$ref": "#/$defs/id" },
        "parentId": { "$ref": "#/$defs/id" },
        "index": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "const": "component.update" },
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": ["string", "null"], "maxLength": 80 },
        "props": { "type": "object", "maxProperties": 30 },
        "styles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "base": { "$ref": "#/$defs/stylePatch" },
            "tablet": { "$ref": "#/$defs/stylePatch" },
            "mobile": { "$ref": "#/$defs/stylePatch" }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "page", "nodes", "index"],
      "properties": {
        "type": { "const": "page.add" },
        "page": { "$ref": "https://schemas.ai-studio.local/app-definition/v1.json#/$defs/page" },
        "index": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "nodes": { "type": "array", "minItems": 1, "maxItems": 2000, "items": { "$ref": "https://schemas.ai-studio.local/app-definition/v1.json#/$defs/component" } }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "const": "page.remove" },
        "id": { "$ref": "#/$defs/id" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "changes"],
      "properties": {
        "type": { "const": "page.update" },
        "id": { "$ref": "#/$defs/id" },
        "changes": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "name": { "type": "string" },
            "path": { "type": "string" },
            "seo": { "type": "object" }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "changes"],
      "properties": {
        "type": { "const": "tokens.update" },
        "changes": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "colors": { "type": "object" },
            "fonts": { "type": "object" },
            "radius": { "type": "string" }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "changes"],
      "properties": {
        "type": { "const": "site.update" },
        "changes": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "name": { "type": "string" },
            "seo": { "type": "object" },
            "settings": { "type": "object" }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
    "stylePatch": {
      "type": "object",
      "maxProperties": 40,
      "propertyNames": { "pattern": "^[a-zA-Z]{1,32}$" },
      "additionalProperties": { "type": ["string", "number", "null"] }
    }
  }
}
