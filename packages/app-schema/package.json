{
  "name": "@studio/app-schema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema/*": "./schema/*"
  },
  "scripts": {
    "generate": "node scripts/compile-validators.mjs",
    "fixtures": "node --experimental-strip-types scripts/generate-fixtures.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@studio/component-registry": "0.1.0"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
